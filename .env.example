# === Telegram ===
# Получить через @BotFather для @numenapp
BOT_TOKEN=

# Дополнительно для production
BOT_WEBHOOK_DOMAIN=
BOT_WEBHOOK_SECRET=

# === Anthropic Claude ===
# Получить на console.anthropic.com
# ВАЖНО: на dev-машине Леона должно быть unset — иначе перебивает Max-OAuth
# (см. feedback в auto-memory). На production-сервере — ставится.
ANTHROPIC_API_KEY=

# === Supabase ===
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# === Платежи (фаза 1, task-110) ===
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# === Гео (фаза 1, task-103) ===
# OpenStreetMap Nominatim — бесплатно, дефолт
# Google Maps API — fallback при сбое Nominatim
GOOGLE_MAPS_API_KEY=

# === Мониторинг ===
SENTRY_DSN=

# === Каналы и админы ===
# Channel @heynumen для автопостинга
CHANNEL_ID=
# Чат для алертов о сбоях бота
ADMIN_CHAT_ID=

# === Общее ===
NODE_ENV=development
LOG_LEVEL=info
